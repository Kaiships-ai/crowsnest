{
  "$schema": "https://raw.githubusercontent.com/nicolo-ribaudo/oxc-project.github.io/refs/heads/json-schemas/oxfmt/v0.41.0/config.json",
  "singleQuote": true,
  "semi": false,
  "printWidth": 100,
  "trailingComma": "none",
  "ignorePatterns": [
    "cloud/**",
    "resources/licenses/**",
    ".github/actions/cloud-sql-rollout-lease/**",
    ".anti-slop-plugin/**",
    "src/main/runtime/__fixtures__/*.timing.json",
    "resources/skills/released-digests.json",
    "src/server/**",
    "src/lib/**",
    "src/kai-cli/**",
    "src/test/**",
    "scripts/**",
    "server.ts",
    "drizzle/**",
    "drizzle.config.ts",
    "services/**",
    "packaging/**",
    "documents/**",
    ".claude/**",
    ".agents/**",
    "AGENTS.md",
    "CLAUDE.md",
    "DESIGN.md",
    "PRODUCT.md",
    "README.md",
    "mkdocs.yml",
    ".mcp.json"
  ]
}
