{
  "name": "crowsnest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts",
    "studio": "bash scripts/studio-run.sh --no-lock pnpm dev",
    "studio:test": "bash scripts/studio-run.sh pnpm test",
    "build": "bash scripts/heavy.sh next build",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "bash scripts/heavy.sh eslint",
    "db:generate": "drizzle-kit generate",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "test": "bash scripts/heavy.sh vitest run",
    "test:changed": "bash scripts/heavy.sh vitest run --changed origin/main",
    "test:watch": "vitest",
    "ig:service": "bash scripts/ig-service.sh",
    "typecheck": "bash scripts/heavy.sh tsc --noEmit",
    "db:bootstrap": "tsx src/server/db/bootstrap.ts",
    "verify:live": "bash scripts/verify-live.sh",
    "e2e": "bash scripts/e2e/run.sh",
    "test:e2e": "playwright test",
    "skill-lint": "bash scripts/skill-lint.sh",
    "ig:import-session": "bash scripts/import-session.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@shadcn/react": "^0.3.1",
    "better-sqlite3": "^13.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "p-queue": "^9.3.3",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.82.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "jsdom": "^30.0.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
