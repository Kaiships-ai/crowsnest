# Crowsnest environment template. Copy to .env.local and fill in.
# .env.local is gitignored. Never commit real credentials.
#
# Every variable below is validated at boot by src/server/config.ts — the app REFUSES
# TO START if a required one is missing or malformed, rather than failing later.

# ---------------------------------------------------------------- required

# Shared secret for the localhost-only Node -> Python sidecar hop. Any long random
# string; both processes read the same value. An unauthenticated sidecar would let any
# local process drive a logged-in Instagram session.
IG_SERVICE_TOKEN=change-me-to-a-long-random-string

# ---------------------------------------------------------------- Instagram account
# Read by the Python sidecar only. The browser never receives these and no server
# action accepts a password argument.
#
# ⚠️  READ services/ig/README.md FIRST. instagrapi drives Instagram's PRIVATE API.
#     This violates Meta's Terms of Service and the account WILL sometimes be
#     challenged, rate-limited, or banned. Use a throwaway account you can afford to
#     lose — never your main one.
IG_USERNAME=
IG_PASSWORD=

# Where the authenticated session blob is persisted so we don't re-login every run
# (re-login storms are what get accounts flagged). Written with mode 0600.
IG_SESSION_PATH=data/ig-session.json

# Optional: pins the device fingerprint so the session looks like the same phone across
# restarts. Defaults to a deterministic hash of the username.
IG_DEVICE_SEED=

# Optional: proxy DSN, e.g. http://user:pass@host:port
IG_PROXY=

# ---------------------------------------------------------------- sidecar wiring
IG_SERVICE_URL=http://127.0.0.1:8765
IG_REQUEST_TIMEOUT_MS=30000
IG_DOWNLOAD_TIMEOUT_MS=120000

# ---------------------------------------------------------------- sync window
# How far back a sync reaches. The stop condition is a DATE, not a post count.
LOOKBACK_DAYS=30
# Safety cap per channel per run.
MAX_ITEMS_PER_SYNC=200
# 0 disables the background interval loop (manual sync only).
SYNC_INTERVAL_MINUTES=0

# ---------------------------------------------------------------- media storage
# Downloaded thumbnails/videos/avatars live here and are served from /api/media/<id>.
# Instagram CDN URLs are signed and expire within hours, so nothing renders them.
MEDIA_ROOT=data/media
# false = videos download on first play (saves gigabytes; first play is slower).
# true  = every in-window video downloaded during sync (instant playback, lots of disk).
EAGER_VIDEO_DOWNLOAD=false
MEDIA_RETENTION_DAYS=90

# ---------------------------------------------------------------- database
CROWSNEST_DB_PATH=data/crowsnest.db

# ---------------------------------------------------------------- Instagram Graph API (own channel insights)
# Optional. A copy of the long-lived token from Kai-Official-OS, pasted in by hand. It
# goes stale independently of that copy — refreshing one does not refresh the other.
# Leave all three blank and the app boots fine; every own-channel screen (My channel,
# the Settings token strip) renders a "not connected" state instead of a number.
# This is UNRELATED to IG_SERVICE_TOKEN above, which is the burner-account sidecar's
# shared secret, not a Graph API credential.
IG_GRAPH_TOKEN=
IG_GRAPH_USER_ID=
IG_GRAPH_API_VERSION=v21.0

# ---------------------------------------------------------------- LLM (existing)
# Analysis + remix. Points at a local 9router proxy, not the real Anthropic API.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=http://localhost:20128
CLAUDE_MODEL=nvidia/minimaxai/minimax-m2.7

# Optional external binaries
YTDLP_BIN_PATH=
LOG_LEVEL=info
