{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "../src/renderer/src/env.d.ts",
    "../src/renderer/src/**/*",
    "../src/renderer/src/**/*.tsx",
    "../src/preload/api-types.ts",
    "../src/preload/api/**/*",
    "../src/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "paths": {
      "@renderer/*": ["../src/renderer/src/*"],
      "@/server/*": ["../src/server/*"],
      "@/lib/format": ["../src/lib/format"],
      "@/lib/outlier-constants": ["../src/lib/outlier-constants"],
      "@/lib/publish-attempts": ["../src/lib/publish-attempts"],
      "@/lib/run-enrichment": ["../src/lib/run-enrichment"],
      "@/lib/script-title": ["../src/lib/script-title"],
      "@/*": ["../src/renderer/src/*"]
    }
  }
}
