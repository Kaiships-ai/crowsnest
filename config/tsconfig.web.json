{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "../src/renderer/src/env.d.ts",
    "../src/renderer/src/**/*",
    "../src/renderer/src/**/*.tsx",
    "../src/preload/api-types.ts",
    "../src/preload/api/**/*",
    "../src/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "paths": {
      "@renderer/*": ["../src/renderer/src/*"],
      // Why: window.api.crowsnest derives its types from the engine with
      // type-only imports, so the engine's own @/server and @/lib imports must resolve here too.
      "@/server/*": ["../src/server/*"],
      "@/lib/*": ["../src/renderer/src/lib/*", "../src/lib/*"],
      "@/*": ["../src/renderer/src/*"]
    }
  }
}
