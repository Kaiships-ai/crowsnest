# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the documented template, which contains no secrets
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local data + secrets
data/*
!data/seeds/
!data/seeds/*.json
!data/seeds/README.md
.env.local

# sdd scratch
.superpowers/

# agent worktrees
.claude/worktrees/
.gstack/

# personal per-machine Claude Code overrides
.claude/settings.local.json

# local SQLite db (do not track)
crowsnest.db
crowsnest.db-wal
crowsnest.db-shm

# packaging build artifacts (bundles + runtimes live on R2, not in git)
/dist/
/packaging/.cache/
/packaging/worker/node_modules/

# SDD scratch (ledger + review packages)
/.superpowers/

# mkdocs build
/site/
/.mkdocs-venv/
.gitnexus

/evidence

# local agent scratch mirrors (real skills live in .claude/skills/)
/.agents/*
!/.agents/playbooks/
/.codex/

# local retro/analytics scratch
/.context/

# Playwright
/test-results/
/playwright-report/
/blob-report/

# local browse-e2e evidence
/test-shots/
